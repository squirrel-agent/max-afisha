POSTGRES_DB=max_afisha
POSTGRES_USER=max_afisha
POSTGRES_PASSWORD=max_afisha
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=8080
PARSER_PORT=8010
ADMIN_TOKEN=replace-with-a-long-random-secret
DAILY_SYNC=1
PARSER_LIMIT=700
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
TEXT_ENCODER_MODEL=intfloat/multilingual-e5-small
TEXT_ENCODER_DEVICE=cpu
AUTO_EMBED_AFTER_INGEST=true
PARSER_SERVICE_URL=http://parser:8010
# ML relevance gates. Weak matches are not shown as personalized results.
RECOMMENDATION_MIN_SEMANTIC_SIMILARITY=0.78
RECOMMENDATION_MIN_FINAL_SCORE=0.62
NEURAL_SEARCH_MIN_SIMILARITY=0.78

# MAX Mini App integration. Keep the real bot token only in local/production .env.
MAX_BOT_TOKEN=
MAX_BOT_NAME=
MAX_WEBHOOK_SECRET=
MAX_INIT_DATA_MAX_AGE_SECONDS=3600
